PORT=4000
NODE_ENV=development

# Qdrant (vector DB)
# Example: http://localhost:6333  (nếu bạn tự chạy qdrant local)
# Example: https://xxxxxx.qdrant.io (nếu bạn dùng Qdrant Cloud)
QDRANT_URL=https://3edb438f-bf4c-464f-836f-3d576a9de57c.us-east4-0.gcp.cloud.qdrant.io
QDRANT_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJhY2Nlc3MiOiJtIn0.Gy4043pPPLHx7N7Lyah9yXPkhjgnAGlSyZWXBp27fhA
QDRANT_COLLECTION=Course2
# Nếu collection dùng named vector (multi-vector) thì set thêm:
QDRANT_VECTOR_NAME=
# Tự tạo payload index (giúp neighbor expansion hoạt động, tránh warning "Index required"):
QDRANT_ENSURE_INDEXES=true
# Nếu bạn dùng model embedding khác 1536 dims thì set:
VECTOR_DIM=1536

OPENAI_API_KEY=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
